    {
      "name": "Story 1 · Identity — the cloned agent can't act",
      "item": [
        {
          "name": "Authorize — RUN FROM THE DEVICE (curl --interface uesimtun0)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-correlator",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/oauth2/authorize?response_type=code&client_id={{clientId}}&redirect_uri=https://demo-app.example/callback&scope=openid number-verification:verify&state=pm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oauth2",
                "authorize"
              ],
              "query": [
                {
                  "key": "response_type",
                  "value": "code"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}"
                },
                {
                  "key": "redirect_uri",
                  "value": "https://demo-app.example/callback"
                },
                {
                  "key": "scope",
                  "value": "openid number-verification:verify"
                },
                {
                  "key": "state",
                  "value": "pm"
                }
              ]
            },
            "description": "Must reach the gateway over the device's mobile data path (http://10.45.0.1:8090). From Postman (off-network) it returns error=access_denied — the 'cloned agent' case. Copy `code` from the device's redirect into the collection variable authCode (valid 60 s).",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "1 · Exchange code → single-use token (sub = SIM)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-correlator",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/oauth2/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oauth2",
                "token"
              ]
            },
            "description": "",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{clientId}}"
                },
                {
                  "key": "password",
                  "value": "{{clientSecret}}"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                },
                {
                  "key": "code",
                  "value": "{{authCode}}"
                },
                {
                  "key": "redirect_uri",
                  "value": "https://demo-app.example/callback"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j && j.access_token !== undefined) pm.collectionVariables.set('accessToken', j.access_token);"
                ]
              }
            }
          ]
        },
        {
